{
  "name": "zwave-config-catalog",
  "version": "0.1.0",
  "description": "Z-Wave JS's device configuration lookup as one script for a plain JavaScript engine, with its index, published per @zwave-js/config release",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node src/build.ts site",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "buffer": "6.0.3",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@zwave-js/config": "15.32.4",
    "quickjs-emscripten": "0.31.0",
    "typescript": "7.0.2"
  }
}
